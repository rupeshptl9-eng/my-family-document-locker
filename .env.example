# ==========================================
# Google Gemini AI Configuration
# ==========================================
# GEMINI_API_KEY: Required for server-side Gemini Vision OCR & Ask AI.
# In AI Studio, this is automatically injected via user secrets.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# GEMINI_MODEL: Which Gemini model to use. Default: gemini-2.0-flash
# (valid options include gemini-2.0-flash, gemini-2.5-flash)
GEMINI_MODEL="gemini-2.0-flash"

# AI_MODE: Hybrid AI Router mode (options: auto, offline, cloud). Default: auto
AI_MODE="auto"

# APP_URL: The base URL where this applet is hosted.
APP_URL="http://localhost:3000"

# ==========================================
# Firebase Authentication, Firestore & Storage
# ==========================================
# In AI Studio, this is auto-provisioned in firebase-applet-config.json.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_AUTH_DOMAIN"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"

# ==========================================
# Google Drive Backup & Restore (OAuth 2.0)
# ==========================================
# Scope: https://www.googleapis.com/auth/drive.file
# OAuth Client ID provisioned via Google Cloud Console
VITE_GOOGLE_OAUTH_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com"
